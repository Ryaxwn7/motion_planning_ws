<?xml version='1.0' encoding='utf-8'?>
<launch>
	<arg name="world_parameter" value="5x10_d2" />
	<include file="$(find sim_env)/launch/config_simtest.launch">
		<arg name="world" value="$(arg world_parameter)" />
		<arg name="map" value="5x10_d2" />
		<arg name="robot_number" value="4" />
		<arg name="rviz_file" value="view_multi.rviz" />
		<arg name="debug" value="false" />
		<arg name="gui" value="true" />
		<arg name="headless" value="false" />
		<arg name="use_rviz" value="true" />
		</include>
	</launch>
