<robot name="wheeltec">
  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0.07"/>
    <parent link="base_footprint"/>
    <child link="base_link"/>
  </joint>
  <!-- Defining the base_link-->
  <link name="base_link">
    <box_inertial_matrix d="0.12" h="0.05" m="0.6" w="0.24"/>
    <visual>
      <geometry>
        <mesh filename="package://wheeltec_description/meshes/mini_mec_control/base_link.STL"/>
      </geometry>
      <material name="white"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="package://wheeltec_description/meshes/mini_mec_control/base_link.STL"/>
      </geometry>
    </collision>
  </link>
  <!-- Defining the colors used in this robot -->
  <material name="black">
    <color rgba="0.0 0.0 0.0 1.0"/>
  </material>
  <material name="blue">
    <color rgba="0.0 0.0 0.8 1.0"/>
  </material>
  <material name="green">
    <color rgba="0.0 0.8 0.0 1.0"/>
  </material>
  <material name="grey">
    <color rgba="0.2 0.2 0.2 1.0"/>
  </material>
  <material name="white">
    <color rgba="1.0 1.0 1.0 1.0"/>
  </material>
  <!--Defining the wheel link in gazebo-->
  <gazebo reference="base_link">
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo>
    <plugin filename="libgazebo_ros_wheeltec_mec.so" name="gazebo_ros_mec_control">
      <robotNamespace>wheeltec</robotNamespace>
      <!--!! 修改了这里 ^^ 删去“/” -->
      <!--Whether TF connects ODOM to Base_footprint,The default value is true. For cartographer, change it to false-->
      <broadcastTF>true</broadcastTF>
      <!--wheel_joint-->
      <leftFrontJoint>left_front_wheel_joint</leftFrontJoint>
      <rightFrontJoint>right_front_wheel_joint</rightFrontJoint>
      <leftRearJoint>left_rear_wheel_joint</leftRearJoint>
      <rightRearJoint>right_rear_wheel_joint</rightRearJoint>
      <!--the axle base,unit: m-->
      <axlebase>0.19</axlebase>
      <!--the wheel base,unit: m-->
      <wheelbase>0.175</wheelbase>
      <!--the wheel diameter,unit: m-->
      <wheelDiameter>0.075</wheelDiameter>
      <!--the torque-->
      <torque>0.6</torque>
      <!--Max velocity,unit m/s-->
      <max_vel>1.4</max_vel>
      <!--Max angular velocity,unit rad/s-->
      <max_turn>3</max_turn>
      <!--ROS: Subscribe to the velocity command topic (usually "cmd_vel")-->
      <commandTopic>cmd_vel</commandTopic>
      <!--!! 修改了这里 ^^ 删去“/” -->
      <!--ROS: Publish to the odometry topic (usually "odom")-->
      <odometryTopic>odom</odometryTopic>
      <!--!! 修改了这里 ^^ 删去“/” -->
      <!--tf connect odometryFrame to robotBaseFrame-->
      <odometryFrame>odom</odometryFrame>
      <robotBaseFrame>base_footprint</robotBaseFrame>
      <updateRate>100.0</updateRate>
      <!--pose twist covariance-->
      <covariance_x>0.0001</covariance_x>
      <covariance_y>0.0001</covariance_y>
      <covariance_yaw>0.01</covariance_yaw>
    </plugin>
  </gazebo>
  <!-- define rplidar_link -->
  <link name="laser_link">
    <box_inertial_matrix d="0.001" h="0.001" m="0.001" w="0.001"/>
    <visual>
      <origin rpy="0 0 0" xyz=" 0 0 0 "/>
      <geometry>
        <mesh filename="package://wheeltec_description/meshes/mini_mec_control/rplidar_link.STL"/>
